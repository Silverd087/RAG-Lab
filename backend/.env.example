# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Cohere API key — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Postgres connection
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_TEST_DB=

# MinIO object storage
MINIO_PORT=
MINIO_ACCESS_KEYS=
MINIO_SECRET_KEYS=
MINIO_BUCKET_NAME=

# Optional overrides (defaults shown — omit to use these)
QDRANT_URL=http://localhost:6333
REDIS_URL=http://localhost:6379
