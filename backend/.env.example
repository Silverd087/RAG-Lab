# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Cohere API key — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage AI API key (embeddings for the Anthropic provider) — https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=

# Postgres connection
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_TEST_DB=

# MinIO object storage
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=

# Optional overrides (defaults shown — omit to use these)
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
